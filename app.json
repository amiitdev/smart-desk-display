{
  "expo": {
    "name": "Smart Desk Display",
    "slug": "smart-desk-display",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "smartdesk",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000714",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#000714",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amiitdev.smartdesk"
    },
    "android": {
      "package": "com.amiitdev.smartdesk",
      "versionCode": 1,
      "usesCleartextTraffic": false,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#000714",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#38E1FF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Smart Desk uses your location to fetch local weather."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000714",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "./plugins/withSmartDeskWidgets.js",
      "./plugins/withAudioVisualizer.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
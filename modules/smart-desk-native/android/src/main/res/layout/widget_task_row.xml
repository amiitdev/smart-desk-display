<?xml version="1.0" encoding="utf-8"?>
<!-- One pending task row in the large widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/task_check"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:contentDescription="Toggle task"
        android:src="@drawable/ic_checkbox_off"
        android:tint="@color/wd_cyan" />

    <TextView
        android:id="@+id/task_deadline"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:maxLines="1"
        android:text="today"
        android:textColor="@color/wd_cyan"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/task_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Task"
        android:textColor="@color/wd_text"
        android:textSize="10sp" />
</LinearLayout>
